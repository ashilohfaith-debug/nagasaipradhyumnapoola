{
  "name": "dynamic-workspace-svg",
  "version": "1.0.0",
  "description": "Production-ready dynamic SVG workspace clock – pixel-art background with real-time overlay",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/node": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "typescript": "^5.3.0",
    "vercel": "^33.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
