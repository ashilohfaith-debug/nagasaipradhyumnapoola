{
  "version": 2,
  "functions": {
    "api/workspace.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/workspace\\.svg",
      "dest": "/api/workspace.ts"
    },
    {
      "src": "/api/workspace",
      "dest": "/api/workspace.ts"
    },
    {
      "src": "/preview/(.*)",
      "dest": "/preview/$1"
    },
    {
      "src": "/preview",
      "dest": "/preview/index.html"
    }
  ],
  "env": {
    "TZ": "Asia/Kolkata"
  }
}